# Production Environment - Example
NODE_ENV=production
PORT=5000
DATABASE_URL="file:/app/data/production.db"

# EXTREMELY IMPORTANT:
# Replace this with a generated cryptographically secure key of at least 32 chars!
# DO NOT commit the actual .env file.
JWT_SECRET="generate_a_real_secret_value_for_production_of_32_chars_minimum!"

ALLOWED_ORIGINS="https://standup.yourdomain.com"
