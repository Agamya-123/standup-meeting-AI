# Server Environment Configuration
# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# SQLite Database Connection String
DATABASE_URL="file:./dev.db"

# Secret Key for JWT Signing (Minimum 32 characters in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Allowed CORS Origins (comma-separated list of origins for production)
# In development, localhost origins are automatically permitted
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional AI / LLM Integrations
GROQ_API_KEY="your-groq-api-key-here"
